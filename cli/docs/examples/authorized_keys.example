# Example authorized_keys file
# Add your SSH public keys here, one per line
#
# Generate a key with:
#   ssh-keygen -t ed25519 -f ~/.ssh/git_server -N "" -C "user@git-server"
#
# Or copy your existing key:
#   cat ~/.ssh/id_rsa.pub >> authorized_keys
#
# Example entries:
# ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyDataHere user1@example.com
# ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQExampleKeyDataHere user2@example.com
#
# You can fetch keys from GitHub:
#   curl https://github.com/username.keys >> authorized_keys
