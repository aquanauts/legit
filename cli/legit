#!/bin/bash
set -euo pipefail

# Configuration
IMAGE="${LEGIT_IMAGE:-ghcr.io/aquanauts/legit-server:latest}"
SSH_PORT="${LEGIT_SSH_PORT:-2222}"
LEGIT_HOME="${LEGIT_HOME:-${HOME}/.legit}"
REPOS_DIR="${LEGIT_REPOS_DIR:-${LEGIT_HOME}/repos}"
HOST_KEYS_DIR="${LEGIT_HOST_KEYS_DIR:-${LEGIT_HOME}/host_keys}"
AUTH_KEYS="${HOME}/.ssh/authorized_keys"
CONTAINER_NAME="legit-server-${SSH_PORT}"

# Validation
if [[ ! -f "$AUTH_KEYS" ]]; then
    echo "Error: $AUTH_KEYS not found" >&2
    exit 1
fi

if ! command -v docker &>/dev/null; then
    echo "Error: Docker is not installed" >&2
    exit 1
fi

# Parse MOUNT_DIRS and build mount flags
MOUNT_FLAGS=()
if [ -n "${MOUNT_DIRS:-}" ]; then
    IFS=':' read -ra DIRS <<< "$MOUNT_DIRS"
    for dir in "${DIRS[@]}"; do
        if [ -d "$dir" ]; then
            basename=$(basename "$dir")
            MOUNT_FLAGS+=("-v" "${dir}:/home/git/${basename}")
        else
            echo "Warning: $dir does not exist, skipping mount" >&2
        fi
    done
fi

# Create required directories
mkdir -p "$REPOS_DIR" "$HOST_KEYS_DIR"

# Run container
exec docker run --rm -d \
    --platform linux/amd64 \
    --name "$CONTAINER_NAME" \
    -p "${SSH_PORT}:22" \
    -e GIT_USER_UID="$(id -u)" \
    -e GIT_USER_GID="$(id -g)" \
    -v "${AUTH_KEYS}:/root/git_authorized_keys:ro" \
    -v "${HOST_KEYS_DIR}:/etc/ssh/ssh_host_keys" \
    "${MOUNT_FLAGS[@]+"${MOUNT_FLAGS[@]}"}" \
    "$IMAGE"
