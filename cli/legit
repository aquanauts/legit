#!/bin/bash
set -euo pipefail

IMAGE="${LEGIT_IMAGE:-ghcr.io/aquanauts/legit-server:latest}"
SSH_PORT="${LEGIT_SSH_PORT:-2222}"
AUTH_KEYS="${HOME}/.ssh/authorized_keys"

if [[ ! -f "$AUTH_KEYS" ]]; then
    echo "Error: $AUTH_KEYS not found" >&2
    exit 1
fi

if ! command -v docker &>/dev/null; then
    echo "Error: Docker is not installed" >&2
    exit 1
fi

exec docker run --rm \
    --name legit-server \
    -p "${SSH_PORT}:22" \
    -v "${AUTH_KEYS}:/home/git/.ssh/authorized_keys:ro" \
    -v git-repos:/srv/git \
    "$IMAGE" "$@"
