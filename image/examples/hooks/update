#!/bin/bash
# Example update hook
# This hook runs once for each branch being pushed
# Unlike pre-receive which runs once for all refs, update runs per ref
# Exit with non-zero status to reject the update for this specific ref

refname="$1"
oldrev="$2"
newrev="$3"

# Extract branch name
branch="${refname#refs/heads/}"

echo "Update hook: checking $branch"

# Example 1: Prevent deletion of protected branches
if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
    echo "Branch deletion detected: $branch"

    # Protect specific branches from deletion
    if [ "$branch" = "main" ] || [ "$branch" = "master" ] || [ "$branch" = "production" ]; then
        echo "ERROR: Cannot delete protected branch '$branch'"
        exit 1
    fi

    echo "Branch deletion allowed"
    exit 0
fi

# Example 2: Enforce fast-forward only on specific branches
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    if [ "$oldrev" != "0000000000000000000000000000000000000000" ]; then
        # Check if this is a fast-forward update
        if ! git merge-base --is-ancestor "$oldrev" "$newrev"; then
            echo "ERROR: Non-fast-forward push to $branch is not allowed"
            echo "Please pull the latest changes and rebase your commits"
            exit 1
        fi
    fi
fi

# Example 3: Enforce naming conventions for branches
# Uncomment to enforce:
# if ! echo "$branch" | grep -qE '^(main|master|develop|feature/|bugfix/|hotfix/|release/)'; then
#     echo "ERROR: Invalid branch name: $branch"
#     echo "Branch names must match: main, master, develop, feature/*, bugfix/*, hotfix/*, or release/*"
#     exit 1
# fi

# Example 4: Require code review for production branch
# if [ "$branch" = "production" ]; then
#     # Check if commit has been reviewed (example: check commit message for "Reviewed-by:")
#     commits=$(git rev-list $oldrev..$newrev)
#     for commit in $commits; do
#         if ! git log -1 --pretty=format:'%b' $commit | grep -q "Reviewed-by:"; then
#             echo "ERROR: Commits to production must be reviewed"
#             echo "Commit $commit is missing 'Reviewed-by:' tag"
#             exit 1
#         fi
#     done
# fi

# Example 5: Check author email domain
# Uncomment to enforce:
# commits=$(git rev-list $oldrev..$newrev)
# for commit in $commits; do
#     author_email=$(git log -1 --pretty=format:'%ae' $commit)
#     if ! echo "$author_email" | grep -qE '@(example\.com|company\.com)$'; then
#         echo "ERROR: Invalid author email: $author_email"
#         echo "Commit: $commit"
#         echo "Only @example.com or @company.com emails are allowed"
#         exit 1
#     fi
# done

echo "Update hook passed for $branch"
exit 0
